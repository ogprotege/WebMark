{
  "manifest_version": 3,
  "name": "WebMark — Margin Notes for Pages & PDFs",
  "version": "0.1.0",
  "description": "Read any web page or PDF with a Markdown notes column in the margin. Highlight passages and they become blockquotes you can take notes on.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Toggle WebMark notes (Alt+M)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage", "contextMenus", "scripting", "tabs", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/core/util.js",
        "src/core/markdown.js",
        "src/core/anchor.js",
        "src/core/storage.js",
        "src/core/highlighter.js",
        "src/core/export.js",
        "src/core/panel.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": { "default": "Alt+M" },
      "description": "Toggle the WebMark notes panel"
    },
    "capture-selection": {
      "suggested_key": { "default": "Alt+H" },
      "description": "Add the current selection to WebMark"
    }
  },
  "options_ui": {
    "page": "src/manager/manager.html",
    "open_in_tab": true
  }
}
